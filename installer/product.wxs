<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-machine MSI (UAC/admin): files -> %ProgramFiles%\ifredrixDownloadManager,
  Start Menu shortcut, Add/Remove Programs entry. No Desktop icon component:
  the app offers one once on first run (and Uninstall.exe removes it).

  Dialog chain via WixUI_InstallDir_X64: Welcome -> License (LICENSE, MIT) ->
  InstallDir -> VerifyReady. The RTF license text overrides the wixlib default
  through <WixVariable Id="WixUILicenseRtf"> (the !(wix.WixUILicenseRtf=...)
  token in the UI extension; -d/-env/-bindpath do NOT reach it).

  Deliberately NOT touched by the MSI:
    - .torrent association and autostart: both are handled inside the app
      (menu "Associate .torrent files", Settings "start with Windows"),
      so uninstalling never leaves stray HKCU state behind.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ifredrix Download Manager (Beta)"
           Manufacturer="ifredrix"
           Version="0.1.0"
           UpgradeCode="A7C2E9D4-5B31-4F8E-9C60-2D1E84F30B75"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="ifredrix Download Manager - multi-connection download manager" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ifredrix Download Manager is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Dialog kelayakan: diblokir dengan pesan jelas bila perangkat tak
         didukung (gagal di sini, bukan aplikasi crash setelah pasang). -->
    <Launch Condition="VersionNT64"
            Message="ifredrix Download Manager membutuhkan Windows 64-bit (x64)." />
    <Launch Condition="(VersionNT &gt; 603) OR (VersionNT = 603 AND WindowsBuild &gt;= 14393)"
            Message="ifredrix Download Manager membutuhkan Windows 10 versi 1607 (build 14393) atau lebih baru." />

    <!-- Installer dialog chain (per-machine => UAC prompt on install). -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir_X64" />

    <!-- Real MIT license for the License dialog (replaces the wixlib
         "Lorem ipsum" placeholder). Path resolves from the build cwd (repo root). -->
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

    <!-- Branded bitmaps (replace the stock WiX maroon): banner 493x58,
         welcome dialog panel 493x312. Same override mechanism as above. -->
    <WixVariable Id="WixUIBannerBmp" Value="installer\Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="installer\Dialog.bmp" />

    <Icon Id="AppIcon.ico" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ifredrixDownloadManager" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="D4B61F02-7C55-4A3E-B0E9-9A2F3C81D6A4">
        <Shortcut Id="StartMenuShortcut"
                  Name="ifredrix Download Manager"
                  Description="ifredrix Download Manager"
                  Target="[INSTALLFOLDER]ifredrixDownloadManager.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\ifredrixDownloadManager"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="UninstallShortcut" Guid="B7D95274-80DA-4920-8F1C-81A3173B820A">
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall ifredrix Download Manager"
                  Description="Uninstall ifredrix Download Manager"
                  Target="[INSTALLFOLDER]Uninstall.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\ifredrixDownloadManager"
                       Name="UninstallShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- No Desktop icon component: the app asks once on first run and owns
         the .lnk itself (DesktopShortcut.cs); Uninstall.exe cleans it up.
         Keeping it out of the MSI also means no installer option dialog. -->
    <Feature Id="Main" Title="ifredrix Download Manager" Level="1">
      <!-- All published files, harvested recursively from the bind path "pub". -->
      <Files Include="!(bindpath.pub)\**" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UninstallShortcut" />
    </Feature>
  </Package>
</Wix>
