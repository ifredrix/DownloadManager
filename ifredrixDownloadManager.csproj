<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>IfredrixDownloadManager</RootNamespace>
    <AssemblyName>ifredrixDownloadManager</AssemblyName>
    <Product>ifredrix Download Manager</Product>
    <Company>ifredrix</Company>
    <Version>1.0.0</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

  <!--
    Browser extensions are plain files the user loads unpacked; they must ship
    next to the exe or the integration dialog points at a missing folder.
  -->
  <ItemGroup>
    <Content Include="BrowserExtension\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- The WPF try-out shell lives in Wpf/ with its own project. -->
  <ItemGroup>
    <Compile Remove="Wpf\**" />
    <Page Remove="Wpf\**" />
    <ApplicationDefinition Remove="Wpf\**" />
    <EmbeddedResource Remove="Wpf\**" />
    <None Remove="Wpf\**" />
  </ItemGroup>

</Project>